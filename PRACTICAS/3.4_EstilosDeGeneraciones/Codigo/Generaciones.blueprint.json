                "makeConnectionId": 10723755
            },
            "mapper": {
                "files": [],
                "message": "     ABUELO/A:\r\n     {{1.abuelo}}\r\n\r\n     PADRE/MADRE:\r\n     {{1.padre}}\r\n\r\n     AMIGO/A:\r\n     {{1.amigo}}",
